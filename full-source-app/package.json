{
  "name": "veo-workflow-tools-full",
  "version": "1.7.14",
  "productName": "Veo Workflow Tools",
  "description": "Full-source desktop build for Veo workflow tools",
  "author": "Veo Workflow Tools",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "types"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "chrome-remote-interface": "^0.33.3",
    "electron-updater": "^6.1.7",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^7.0.0",
    "node-machine-id": "^1.1.12",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "puppeteer-core": "^24.37.5",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/launch-full-source-dev.ps1",
    "typecheck": "npm --prefix apps/server run typecheck && npm --prefix apps/renderer run typecheck",
    "dev:renderer": "npm --prefix apps/renderer run dev",
    "dev:electron": "npm --prefix apps/electron run dev",
    "build": "npm run build:all",
    "build:all": "npm run build:server && npm run build:renderer && npm run build:electron",
    "build:server": "npm --prefix apps/server run build",
    "build:renderer": "npm --prefix apps/renderer run build",
    "build:electron": "npm --prefix apps/electron run build",
    "build:desktop": "npm run build:renderer && npm run build:electron",
    "build:release": "bash ./build-release.sh",
    "build:release:win": "bash ./build-release.sh win",
    "build:release:mac": "bash ./build-release.sh mac",
    "build:release:all": "bash ./build-release.sh all",
    "download:python": "npx ts-node scripts/download-python.ts --force",
    "clean": "rm -rf apps/server/dist apps/renderer/dist apps/electron/dist node_modules/.vite",
    "clean:client": "rm -rf apps/renderer/.vite apps/renderer/node_modules/.vite apps/renderer/dist apps/electron/dist apps/electron/dist-electron .vite node_modules/.vite",
    "clean:all": "npm run clean && rm -rf node_modules apps/*/node_modules",
    "clean:release": "rm -rf release",
    "install:all": "npm install && npm --prefix apps/server install && npm --prefix apps/renderer install && npm --prefix apps/electron install",
    "prisma:generate": "npm --prefix apps/server run db:generate",
    "prisma:migrate": "npm --prefix apps/server run db:migrate",
    "prisma:studio": "npm --prefix apps/server run prisma:studio",
    "lint": "echo \"TODO: add lint\" && exit 0",
    "test": "echo \"TODO: add root test\" && exit 0",
    "test:architecture": "npm --prefix apps/server run test:architecture",
    "pack:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/pack-full-source.ps1"
  },
  "main": "main-full.js"
}
