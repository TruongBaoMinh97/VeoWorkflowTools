{
  "name": "veo-workflow-tools-full",
  "version": "1.7.14",
  "productName": "Veo Workflow Tools",
  "description": "Full-source desktop build for Veo workflow tools",
  "author": "Veo Workflow Tools",
  "private": true,
  "workspaces": [],
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "chrome-remote-interface": "^0.33.3",
    "electron-updater": "^6.1.7",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^7.0.0",
    "node-machine-id": "^1.1.12",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "puppeteer-core": "^24.37.5",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --prefix full-source-app/apps/server run dev",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-full-source-dev.ps1",
    "start:server": "npm --prefix full-source-app/apps/server run start",
    "typecheck": "npm --prefix full-source-app/apps/server run typecheck && npm --prefix full-source-app/apps/renderer run typecheck",
    "test": "npm --prefix full-source-app/apps/server run test:architecture",
    "test:architecture": "npm --prefix full-source-app/apps/server run test:architecture",
    "test:watch": "npm --prefix full-source-app/apps/server run test:watch",
    "build": "npm run build:server && npm run build:renderer",
    "build:server": "npm --prefix full-source-app/apps/server run build",
    "build:renderer": "npm --prefix full-source-app/apps/renderer run build",
    "install:source": "npm --prefix full-source-app/apps/server install",
    "prisma:generate": "npm --prefix full-source-app/apps/server run db:generate",
    "prisma:migrate": "npm --prefix full-source-app/apps/server run db:migrate",
    "prisma:studio": "npm --prefix full-source-app/apps/server run prisma:studio"
  },
  "main": "full-source-app/main-full.js"
}
